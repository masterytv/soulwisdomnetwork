# The ffmpeg build every workflow uses (.github/actions/ffmpeg/action.yml), in one place. Change all three
# together: the BtbN release it came from, the build (the asset's name, and the folder inside it) and its
# sha256. A push of a change here to staging or main runs ffmpeg_copy.yml, which copies the build into this
# repo's own release named after the build, where the install step finds it from then on.
FFMPEG_BTBN_TAG=autobuild-2026-11-09-12-42
FFMPEG_BUILD=ffmpeg-N-128718-gb2b543c079-linux64-gpl
FFMPEG_SHA256=143adb601603057053bf52f157daf36728e716b86fae764952271cdb4b3d56bc
